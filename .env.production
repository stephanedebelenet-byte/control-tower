# Mojazine Production Environment
# DO NOT commit this file — configure in Vercel Console instead

# Database (AWS RDS PostgreSQL)
DATABASE_URL="postgresql://postgres:PASSWORD@ENDPOINT:5432/mojazine_db"

# Node Environment
NODE_ENV="production"

# API URLs
NEXT_PUBLIC_API_URL="https://mojazine-saas.vercel.app"
NEXT_PUBLIC_SOCKET_URL="https://mojazine-saas.vercel.app"

# Socket.IO (WebSocket)
# Uses same domain as app in production

# Redis (Optional — for Bull job queue + caching)
# REDIS_URL="redis://localhost:6379"
# In Vercel, use Upstash Redis or similar

# Security
JWT_SECRET="GENERATE_WITH: openssl rand -base64 32"

# Maps (Optional)
# NEXT_PUBLIC_MAPBOX_TOKEN=""

# Logging & Monitoring
LOG_LEVEL="info"
# Optional: Sentry, DataDog, etc.
